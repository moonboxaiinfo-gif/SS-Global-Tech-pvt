# Supabase browser configuration (safe to expose through Vite as publishable values)
# Get these from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_ANON_KEY

# Optional analytics; leave unset to disable analytics.
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-host.example
# VITE_ANALYTICS_WEBSITE_ID=your-website-id
